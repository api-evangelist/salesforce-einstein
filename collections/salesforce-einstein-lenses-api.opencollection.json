{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Einstein Bots AI Record Insights Lenses API",
    "version": "58.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.salesforce.com/services/oauth2/authorize",
      "accessTokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Lenses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesforce Einstein List lenses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v58.0/wave/lenses",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of analytics lenses (datasets)."
        },
        {
          "info": {
            "name": "Salesforce Einstein Get a lens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v58.0/wave/lenses/:lensId",
            "params": [
              {
                "name": "lensId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns details of a specific analytics lens."
        }
      ]
    }
  ],
  "bundled": true
}